PORT=18890
HOST=0.0.0.0
PUBLIC_BASE_URL=https://macs.rctrusts.com

# Optional HTTPS listener.
TLS_CERT_FILE=
TLS_KEY_FILE=
FORCE_HTTPS=0

# Optional PostgreSQL storage.
DATABASE_URL=
DATABASE_SSL=0
PGPOOL_MAX=10

# Notifications.
OWNER_NOTIFICATION_EMAIL=owner@example.com
NOTIFICATION_FROM_EMAIL=security@example.com
MAIL_HELO_NAME=example.com
MAIL_REQUIRE_TLS=1
MAIL_DIRECT_MX_FALLBACK=0
MAIL_OUTBOX_MAX_PER_RUN=20

# PostgreSQL backup helper defaults.
POSTGRES_CONTAINER_NAME=lawnquote-postgres
POSTGRES_DB=lawnquote
POSTGRES_USER=lawnquote
POSTGRES_BACKUP_KEEP=30

# Android release signing. Keep real values out of Git.
MACS_LAWNQUOTE_KEYSTORE=/absolute/path/to/macs-lawnquote-release.jks
MACS_LAWNQUOTE_KEYSTORE_PASSWORD=
MACS_LAWNQUOTE_KEY_ALIAS=macs-lawnquote
MACS_LAWNQUOTE_KEY_PASSWORD=
