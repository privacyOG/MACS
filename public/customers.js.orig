import{authStatus,initAccessibleNavigation,listQuoteJobs,listRecurringJobs,listRosterJobs,requireAdminSession,updateCustomerContact}from"./auth.js";import{haptic,enablePullToRefresh}from"./shared-utils.js";const searchInput=document.querySelector("#customer-search"),summary=document.querySelector("#customer-summary"),customerList=document.querySelector("#customer-list");let customerRows=[],currentUser=null;function money(e){return new Intl.NumberFormat("en-AU",{style:"currency",currency:"AUD",maximumFractionDigits:0}).format(e||0)}function dateLabel(e){return e?new Date(`${e}T12:00:00`).toLocaleDateString("en-AU",{day:"2-digit",month:"2-digit",year:"numeric"}):"No date"}function customerKey(e){return`${String(e.customerName||"Unknown customer").trim().toLowerCase()}|${String(e.address||"No address").trim().toLowerCase()}`}function contactLabel(e){return[e.customerPhone||e.phone||e.mobile||"",e.customerEmail||e.email||""].filter(Boolean).join(" · ")||"No contact saved"}function escapeAttribute(e){return String(e||"").replace(/[&<>"']/g,e=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[e]))}function statusLabel(e){return{pending:"Pending quote",accepted:"Accepted",assigned:"Assigned",completed_pending_approval:"Awaiting approval",approved:"Approved",rejected:"Rejected",active:"Active",archived:"Archived"}[e]||e||"Unknown"}function addStat(e,t){const s=document.createElement("article");s.className="dashboard-stat",s.innerHTML=`<span>${e}</span><strong>${t}</strong>`,summary.append(s)}function groupCustomers(e,t,s){const r=new Map;for(const n of[...e,...t,...s]){const e=customerKey(n);r.has(e)||r.set(e,{customerName:n.customerName||"Unknown customer",address:n.address||"No address",customerPhone:n.customerPhone||n.phone||n.mobile||"",customerEmail:n.customerEmail||n.email||"",quotes:[],rosterJobs:[],recurringJobs:[]});const t=r.get(e);t.customerPhone||=n.customerPhone||n.phone||n.mobile||"",t.customerEmail||=n.customerEmail||n.email||"","scheduledDate"in n&&"sourceType"in n?t.rosterJobs.push(n):"frequency"in n?t.recurringJobs.push(n):t.quotes.push(n)}return[...r.values()].sort((e,t)=>e.customerName.localeCompare(t.customerName))}function renderSummary(e){summary.replaceChildren();const t=e.reduce((e,t)=>e+t.quotes.length,0),s=e.reduce((e,t)=>e+t.rosterJobs.length,0),r=e.reduce((e,t)=>e+t.rosterJobs.filter(e=>"approved"===e.status).length,0);addStat("Customers",e.length),addStat("Quotes",t),addStat("Roster visits",s),addStat("Approved jobs",r)}function renderCustomers(){const e=searchInput.value.trim().toLowerCase(),t=customerRows.filter(t=>[t.customerName,t.address,t.customerPhone,t.customerEmail].join(" ").toLowerCase().includes(e));renderSummary(t),t.length?customerList.replaceChildren(...t.map(e=>{const t=e.rosterJobs.slice().sort((e,t)=>String(t.scheduledDate||"").localeCompare(String(e.scheduledDate||"")))[0],s=e.quotes.reduce((e,t)=>e+Number(t.price||0),0),r=document.createElement("article");if(r.className="customer-card",r.innerHTML=`\n      <div class="customer-card-head">\n        <div>\n          <strong>${e.customerName}</strong>\n          <span>${e.address}</span>\n          <small>${contactLabel(e)}</small>\n        </div>\n        <div class="customer-card-kpis">\n          <span>${e.quotes.length} quotes</span>\n          <span>${e.rosterJobs.length} visits</span>\n          <span>${money(s)}</span>\n        </div>\n      </div>\n      <div class="customer-history-grid">\n        <div>\n          <span>Latest visit</span>\n          <strong>${t?`${dateLabel(t.scheduledDate)} · ${statusLabel(t.status)}`:"No visits yet"}</strong>\n        </div>\n        <div>\n          <span>Recurring</span>\n          <strong>${e.recurringJobs.length?e.recurringJobs.map(e=>e.frequency||"active").join(", "):"None"}</strong>\n        </div>\n        <div>\n          <span>Next actions</span>\n          <strong>${e.rosterJobs.some(e=>"completed_pending_approval"===e.status)?"Approval needed":"No urgent action"}</strong>\n        </div>\n      </div>\n    `,["owner","leader"].includes(currentUser?.role)){const t=document.createElement("form");t.className="customer-edit-form",t.innerHTML=`\n        <input name="customerName" value="${escapeAttribute(e.customerName)}" placeholder="Customer name" aria-label="Customer name" />\n        <input name="customerPhone" value="${escapeAttribute(e.customerPhone)}" placeholder="Phone/mobile" aria-label="Phone/mobile" />\n        <input name="customerEmail" value="${escapeAttribute(e.customerEmail)}" type="email" placeholder="Email" aria-label="Email" />\n        <input name="address" value="${escapeAttribute(e.address)}" placeholder="Address" aria-label="Address" />\n        <button class="secondary-button compact-button" type="submit">Save details</button>\n      `,t.addEventListener("submit",async s=>{s.preventDefault(),haptic(15);const r=t.querySelector("button"),n=new FormData(t);r.disabled=!0;const o=await updateCustomerContact({matchName:e.customerName,matchAddress:e.address,customerName:n.get("customerName"),customerPhone:n.get("customerPhone"),customerEmail:n.get("customerEmail"),address:n.get("address")});r.disabled=!1,r.textContent=o.ok?`Saved ${o.updated}`:"Save failed",await loadCustomers()}),r.append(t)}return r})):customerList.innerHTML='<p class="empty-state">No matching customers or properties.</p>'}async function loadCustomers(){showCustomerSkeletons();const[e,t,s]=await Promise.all([listQuoteJobs(),listRosterJobs(),listRecurringJobs()]);customerRows=groupCustomers(e.ok?e.quotes:[],t.ok?t.jobs:[],s.ok?s.jobs:[]),renderCustomers()}function showCustomerSkeletons(){summary.innerHTML='\n    <article class="dashboard-stat skeleton-pulse"><span>Customers</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Quotes</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Roster visits</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Approved jobs</span><strong>-</strong></article>\n  ',customerList.innerHTML='\n    <article class="customer-card skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n      <div class="skeleton-line short"></div>\n    </article>\n    <article class="customer-card skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n      <div class="skeleton-line short"></div>\n    </article>\n  '}async function init(){if(!await requireAdminSession())return;const e=await initAccessibleNavigation();currentUser=e.user||(await authStatus()).user,await loadCustomers()}enablePullToRefresh(loadCustomers),searchInput.addEventListener("input",renderCustomers),init();