import{authStatus,initAccessibleNavigation,listRosterJobs,requireAdminSession}from"./auth.js";import{haptic,enablePullToRefresh}from"./shared-utils.js";const stats=document.querySelector("#invoice-stats"),invoiceList=document.querySelector("#invoice-list");function money(e){return new Intl.NumberFormat("en-AU",{style:"currency",currency:"AUD",maximumFractionDigits:0}).format(e||0)}function dateLabel(e){return e?new Date(`${e}T12:00:00`).toLocaleDateString("en-AU",{day:"2-digit",month:"2-digit",year:"numeric"}):"No date"}function materialCost(e){return Array.isArray(e.materials)?e.materials.reduce((e,t)=>e+Number(t.cost||0),0):0}function invoiceAmount(e){return Number(e.price||0)+materialCost(e)}function contactLabel(e){return[e.customerPhone||"",e.customerEmail||""].filter(Boolean).join(" · ")||"No contact saved"}function addStat(e,t){const n=document.createElement("article");n.className="dashboard-stat",n.innerHTML=`<span>${e}</span><strong>${t}</strong>`,stats.append(n)}function invoiceText(e){return["MACS Mowing & Cleaning Services",`Invoice draft for ${e.customerName||"Customer"}`,`Address: ${e.address||"Not set"}`,`Date: ${dateLabel(e.scheduledDate)}`,`Job: ${e.title||"Roster job"}`,`Quoted/service price: ${money(e.price||0)}`,`Materials: ${money(materialCost(e))}`,`Total: ${money(invoiceAmount(e))}`,e.actualMinutes?`Time logged: ${e.actualMinutes} minutes`:"",e.workNotes?`Notes: ${e.workNotes}`:""].filter(Boolean).join("\n")}function renderInvoices(e){const t=e.filter(e=>"approved"===e.status),n=t.reduce((e,t)=>e+invoiceAmount(t),0),a=t.reduce((e,t)=>e+materialCost(t),0);stats.replaceChildren(),addStat("Ready",t.length),addStat("Service total",money(t.reduce((e,t)=>e+Number(t.price||0),0))),addStat("Materials",money(a)),addStat("Invoice total",money(n)),t.length?invoiceList.replaceChildren(...t.map(e=>{const t=document.createElement("article");t.className="invoice-card";const n=invoiceText(e);return t.innerHTML=`\n      <div>\n        <strong>${e.customerName||e.address||"Customer"}</strong>\n        <span>${dateLabel(e.scheduledDate)} · ${e.address||"No address"} · ${contactLabel(e)}</span>\n        <small>Service ${money(e.price||0)} · Materials ${money(materialCost(e))} · Total ${money(invoiceAmount(e))}</small>\n      </div>\n      <div class="inline-actions">\n        <button class="secondary-button" type="button">Copy invoice draft</button>\n        <a class="primary-button" href="customers.html">Customer history</a>\n      </div>\n    `,t.querySelector("button").addEventListener("click",async()=>{haptic(15),await(navigator.clipboard?.writeText(n)),t.querySelector("button").textContent="Copied"}),t})):invoiceList.innerHTML='<p class="empty-state">No approved roster jobs are ready for invoice yet.</p>'}async function loadInvoices(){showInvoiceSkeletons();const e=await listRosterJobs();renderInvoices(e.ok?e.jobs:[])}function showInvoiceSkeletons(){stats.innerHTML='\n    <article class="dashboard-stat skeleton-pulse"><span>Ready</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Service total</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Materials</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Invoice total</span><strong>-</strong></article>\n  ',invoiceList.innerHTML='\n    <article class="invoice-card skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n      <div class="skeleton-line short"></div>\n    </article>\n    <article class="invoice-card skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n      <div class="skeleton-line short"></div>\n    </article>\n  '}async function init(){if(!await requireAdminSession())return;await initAccessibleNavigation();const e=await authStatus();["owner","leader"].includes(e.user?.role)?await loadInvoices():invoiceList.innerHTML='<p class="empty-state">Only Owner Admin and Team Leader can view invoice queue.</p>'}enablePullToRefresh(loadInvoices),init();