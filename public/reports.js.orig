import{authStatus,initAccessibleNavigation,listFieldOperations,listRosterJobs,requireAdminSession}from"./auth.js";import{enablePullToRefresh,haptic}from"./shared-utils.js";const groupSelect=document.querySelector("#report-group"),downloadButton=document.querySelector("#download-report"),stats=document.querySelector("#report-stats"),reportList=document.querySelector("#report-list"),messageLogList=document.querySelector("#message-log-list"),locationLogList=document.querySelector("#location-log-list");let rosterJobs=[],fieldOperations={messages:[],locations:[]};function dateLabel(e){return e?new Date(`${e}T12:00:00`).toLocaleDateString("en-AU",{day:"2-digit",month:"2-digit",year:"numeric"}):"No date"}function minutesLabel(e){const t=Math.max(0,Math.round(Number(e||0))),n=Math.floor(t/60),s=t%60;return n&&s?`${n}h ${s}m`:n?`${n}h`:`${s}m`}function locationLabel(e){if(!e?.latitude||!e?.longitude)return"No GPS";const t=e.accuracy?` · ${Math.round(e.accuracy)}m`:"";return`${Number(e.latitude).toFixed(5)}, ${Number(e.longitude).toFixed(5)}${t}`}function dateTimeLabel(e){return e?new Date(e).toLocaleString("en-AU",{day:"2-digit",month:"2-digit",year:"numeric",hour:"2-digit",minute:"2-digit"}):"Not recorded"}function loggedJobs(){return rosterJobs.filter(e=>Number(e.actualMinutes||0)>0||e.actualStartTime||e.actualFinishTime)}function groupKey(e){return"employee"===groupSelect.value?e.assignedUsername||"Unassigned":"crew"===groupSelect.value?e.assignedUsername||e.assignedTo||"Crew":e.scheduledDate||"No date"}function groupLabel(e){return"date"===groupSelect.value?dateLabel(e):e}function addStat(e,t){const n=document.createElement("article");n.className="dashboard-stat",n.innerHTML=`<span>${e}</span><strong>${t}</strong>`,stats.append(n)}function renderReports(){const e=loggedJobs(),t=e.reduce((e,t)=>e+Number(t.actualMinutes||0),0);if(stats.replaceChildren(),addStat("Entries",e.length),addStat("Total time",minutesLabel(t)),addStat("Employees",new Set(e.map(e=>e.assignedUsername||"Unassigned")).size),addStat("Days",new Set(e.map(e=>e.scheduledDate||"No date")).size),!e.length)return void(reportList.innerHTML='<p class="empty-state">No time has been logged yet.</p>');const n=new Map;for(const t of e){const e=groupKey(t);n.has(e)||n.set(e,[]),n.get(e).push(t)}reportList.replaceChildren(...[...n.entries()].map(([e,t])=>{const n=t.reduce((e,t)=>e+Number(t.actualMinutes||0),0),s=document.createElement("article");s.className="report-group",s.innerHTML=`\n      <header>\n        <strong>${groupLabel(e)}</strong>\n        <span>${t.length} entries · ${minutesLabel(n)}</span>\n      </header>\n    `;const a=document.createElement("div");return a.className="report-entry-list",a.replaceChildren(...t.map(e=>{const t=document.createElement("div");return t.className="report-entry",t.innerHTML=`\n        <strong>${e.assignedUsername||"Unassigned"} · ${e.title||e.customerName||e.address||"Roster job"}</strong>\n        <span>${dateLabel(e.scheduledDate)} · ${e.actualStartTime||"--"}-${e.actualFinishTime||"--"} · ${minutesLabel(e.actualMinutes)}</span>\n        <small>${e.address||"No address"} · In: ${locationLabel(e.checkInLocation)} · Out: ${locationLabel(e.checkOutLocation)}${e.workNotes?` · ${e.workNotes}`:""}</small>\n      `,t})),s.append(a),s}))}function renderFieldOperations(){const e=Array.isArray(fieldOperations.messages)?fieldOperations.messages:[],t=Array.isArray(fieldOperations.locations)?fieldOperations.locations:[];e.length?messageLogList.replaceChildren(...e.slice(0,80).map(e=>{const t=e.document||{},n=document.createElement("article");return n.className="report-group",n.innerHTML=`\n        <header>\n          <strong>${t.customerName||e.recipient||"Customer message"}</strong>\n          <span>${e.channel||t.channel||"message"} · ${e.status||t.status||"logged"}</span>\n        </header>\n        <div class="report-entry-list">\n          <div class="report-entry">\n            <strong>${t.subject||e.subject||"On my way SMS"}</strong>\n            <span>${dateTimeLabel(e.createdAt||e.sentAt||t.createdAt)} · ${t.createdBy||"System"}</span>\n            <small>${t.address||"No address"} · ${e.recipient||t.recipient||"No recipient"}</small>\n          </div>\n        </div>\n      `,n})):messageLogList.innerHTML='<p class="empty-state">No field messages logged yet.</p>',t.length?locationLogList.replaceChildren(...t.slice(0,80).map(e=>{const t=e.document||{},n=document.createElement("article");return n.className="report-group",n.innerHTML=`\n        <header>\n          <strong>${e.username||t.username||"Crew member"}</strong>\n          <span>${e.kind||"location"} · ${dateTimeLabel(e.capturedAt)}</span>\n        </header>\n        <div class="report-entry-list">\n          <div class="report-entry">\n            <strong>${t.customerName||t.address||e.rosterJobId||"Field location"}</strong>\n            <span>${locationLabel(e)}${t.scheduledDate?` · ${dateLabel(t.scheduledDate)}`:""}</span>\n            <small>${t.address||"No address"} · Job ${e.rosterJobId||"not linked"}</small>\n          </div>\n        </div>\n      `,n})):locationLogList.innerHTML='<p class="empty-state">No crew GPS pings logged yet.</p>'}function csvValue(e){return`"${String(e??"").replaceAll('"','""')}"`}function downloadCsv(){const e=[["Date","Employee","Customer","Address","Start","Finish","Minutes","Notes","Check-in GPS","Check-out GPS"]];for(const t of loggedJobs())e.push([t.scheduledDate,t.assignedUsername,t.customerName,t.address,t.actualStartTime,t.actualFinishTime,t.actualMinutes,t.workNotes,locationLabel(t.checkInLocation),locationLabel(t.checkOutLocation)]);const t=e.map(e=>e.map(csvValue).join(",")).join("\n"),n=new Blob([t],{type:"text/csv;charset=utf-8"}),s=document.createElement("a");s.href=URL.createObjectURL(n),s.download=`macs-time-report-${(new Date).toISOString().slice(0,10)}.csv`,s.click(),URL.revokeObjectURL(s.href)}async function loadReports(){if(showReportSkeletons(),!await requireAdminSession())return;await initAccessibleNavigation();const e=await authStatus();if(!["owner","leader"].includes(e.user?.role))return void(reportList.innerHTML='<p class="empty-state">Only Owner Admin and Team Leader can view time reports.</p>');const t=await listRosterJobs();rosterJobs=t.ok?t.jobs:[];const n=await listFieldOperations();fieldOperations=n.ok?{messages:n.messages||[],locations:n.locations||[]}:{messages:[],locations:[]},renderReports(),renderFieldOperations()}function showReportSkeletons(){stats.innerHTML='\n    <article class="dashboard-stat skeleton-pulse"><span>Entries</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Total time</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Employees</span><strong>-</strong></article>\n    <article class="dashboard-stat skeleton-pulse"><span>Days</span><strong>-</strong></article>\n  ',reportList.innerHTML='\n    <article class="report-group skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n      <div class="skeleton-line short"></div>\n    </article>\n  ',messageLogList.innerHTML='\n    <article class="report-group skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n    </article>\n  ',locationLogList.innerHTML='\n    <article class="report-group skeleton-card">\n      <div class="skeleton-line medium"></div>\n      <div class="skeleton-line long"></div>\n    </article>\n  '}groupSelect.addEventListener("change",()=>{haptic(8),renderReports()}),downloadButton.addEventListener("click",()=>{haptic(15),downloadCsv()}),enablePullToRefresh(loadReports,{container:document.querySelector("main")||document.body}),loadReports();